# logguard-mail-bot's settings: /opt/logguard-mail-bot/config.env, read by logguard-mail-bot.service
# (EnvironmentFile). root:logguard-mail-bot 640: it may hold the SMTP password. `logguard-mail-bot --help`
# describes each option. install.sh copies this file there on the first install; it doesn't
# start the bot while MAIL_FROM or MAIL_TO still hold the placeholders below, or the key is
# missing. Check the settings with:
#   set -a; . /opt/logguard-mail-bot/config.env; set +a; /opt/logguard-mail-bot/logguard-mail-bot check

# --- Who ---------------------------------------------------------------------------------

# The sender (and the envelope sender: bounces go there). An address the mail server lets
# this login send as; with SPF/DKIM for its domain, the mails don't land in spam.
MAIL_FROM=REPLACE_WITH_THE_SENDER_ADDRESS
#FROM_NAME=logguard

# The recipients, separated by commas: every mail goes to all of them.
MAIL_TO=REPLACE_WITH_THE_ADMIN_ADDRESS

# --- Encryption --------------------------------------------------------------------------

# The recipients' OpenPGP public keys, all in this one file (root:logguard-mail-bot 640):
# export yours from Thunderbird (Account settings > End-to-end encryption > OpenPGP Key
# Manager > File > Export), OpenKeychain or `gpg --armor --export you@example.org`, and
# append the others' (cat a.asc b.asc > recipients.asc). Each recipient's mails are
# encrypted to the key whose user id has their address (a single key serves any address).
# Required: nothing goes out unencrypted.
OPENPGP_KEY=/opt/logguard-mail-bot/recipients.asc

# The bot's own key, to sign every mail (clients then show who sent it); it also goes out
# in an Autocrypt header, so Thunderbird, K-9/FairEmail and Delta Chat learn it from the
# first mail. Make it once, as root:
#   set -a; . /opt/logguard-mail-bot/config.env; set +a
#   /opt/logguard-mail-bot/logguard-mail-bot keygen --out /opt/logguard-mail-bot/signing.key
#   chown logguard-mail-bot: /opt/logguard-mail-bot/signing.key
# Unset: mails are encrypted, not signed.
#SIGNING_KEY=/opt/logguard-mail-bot/signing.key

# The subject mail servers see; the real one is inside, encrypted (clients show that).
#OUTER_SUBJECT=...

# --- Sanitizing (optional) ---------------------------------------------------------------

# The mails are encrypted end to end, so alerts and digests go out as they are by default.
# on: replace XMPP account names by pseudonyms ([acct:1a2b3c]) and the servers' own addresses
# and host names by their node ids, as logguard-tg-bot does for Telegram. The weekly abuse
# report is never changed. Which account a pseudonym is, as root:
#   set -a; . /opt/logguard-mail-bot/config.env; set +a; /opt/logguard-mail-bot/logguard-mail-bot pseudonym alice@example.org
#SANITIZE=off
# The XMPP domains (a bare user name, ejabberd:alice, counts as on the first one).
#XMPP_DOMAINS=example.org
# Each server's own addresses and host names, replaced by its node id (logguard's [cluster]
# node_id): node=address,address,name; ... Subdomains are included.
#SERVER_NAMES=xmpp=11.24.39.236,example.org; vpn=11.32.48.86
# The key behind the pseudonyms, made on the first start (logguard-mail-bot 600).
#PSEUDONYM_KEY=/opt/logguard-mail-bot/pseudonym.key

# --- The mail server ---------------------------------------------------------------------

# a) The local Postfix (or any mail server on this host): plain SMTP on loopback, no login.
#    The mails are encrypted anyway; Postfix then delivers them with TLS where it can.
#SMTP_HOST=127.0.0.1
#SMTP_PORT=25
#SMTP_TLS=none
#SMTP_AUTH=none

# b) Any other mail server: TLS from the start (tls, port 465) or STARTTLS (starttls, port
#    587), never falling back to plain. The certificate is checked against the system's CAs
#    (/etc/ssl/certs) and SMTP_TLS_NAME (default: SMTP_HOST), or only against SMTP_CA_FILE.
SMTP_HOST=smtp.example.org
SMTP_TLS=starttls
#SMTP_PORT=587
#SMTP_TLS_NAME=smtp.example.org
#SMTP_CA_FILE=/opt/logguard-mail-bot/smtp-ca.pem

# The login: auto (PLAIN or LOGIN, whichever the server offers), plain, login, or none.
# The password in its own file (root:logguard-mail-bot 640), not here: SMTP_PASSWORD would do,
# but this file is longer-lived and gets copied around more.
SMTP_AUTH=auto
SMTP_USER=REPLACE_WITH_THE_LOGIN
SMTP_PASSWORD_FILE=/opt/logguard-mail-bot/smtp-password

# The name the bot gives in EHLO (default: MAIL_FROM's domain); some servers want the host's.
#HELO_NAME=vpn.example.org
#SMTP_TIMEOUT_SECS=30

# --- The outbox --------------------------------------------------------------------------

# Where logguard puts the messages and files ([notify] mail_outbox in logguard.toml).
#OUTBOX_DIR=/opt/logguard-mail-bot/outbox
# Unsent alerts are dropped after this many hours (counted in a mail instead), files after
# this many days.
#ALERT_MAX_HOURS=24
#OUTBOX_MAX_DAYS=7
#LOG_DIR=/var/log/logguard-mail-bot
