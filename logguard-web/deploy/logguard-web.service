[Unit]
Description=logguard-web - read-only web console and agent for a logguard cluster
After=network-online.target logguard.service
Wants=network-online.target

[Service]
Type=simple
# Its own user: it reads logguard's console socket (group logguard-web), never the control
# socket, the cluster key or logguard's state. install.sh creates it and sets the owners and
# modes of /opt/logguard-web.
User=logguard-web
Group=logguard-web
WorkingDirectory=/opt/logguard-web
EnvironmentFile=/opt/logguard-web/config.env
ExecStart=/opt/logguard-web/logguard-web

Restart=always
RestartSec=5
# 78: a setting or file is missing or wrong (no certificate, no password, no web key):
# restarting would not help.
RestartPreventExitStatus=78

# Hardening: it reads its files and one socket, listens, and asks the other nodes' agents.
# It writes nothing. For a port below 1024 (443), add in an override (systemctl edit):
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
# logguard's console socket (Unix); the console and the agents (IP)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# A node's snapshot is capped (3000 bans, 500 actions...): a few MB each, parsed. A login
# check (Argon2) takes ~19 MB, one at a time. Threads: one per connection, bounded.
MemoryHigh=96M
MemoryMax=128M
TasksMax=256

[Install]
WantedBy=multi-user.target
