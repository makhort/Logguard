[Unit]
Description=Matrix bot for logguard's admin messages (end-to-end encrypted)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own user: no ejabberd group, no access to ejabberd's files. install.sh creates it
# and sets the owners and modes of /opt/logguard-matrix-bot.
User=logguard-matrix-bot
Group=logguard-matrix-bot
WorkingDirectory=/opt/logguard-matrix-bot
EnvironmentFile=/opt/logguard-matrix-bot/config.env
ExecStart=/opt/logguard-matrix-bot/logguard-matrix-bot

Restart=always
RestartSec=5
# 78: the homeserver no longer knows the login (run `logguard-matrix-bot login`), or a bad
# setting. Restarting would not help.
RestartPreventExitStatus=78

# Hardening: the bot reads its outbox and talks HTTPS to the homeserver, nothing else.
CapabilityBoundingSet=
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ReadWritePaths=/opt/logguard-matrix-bot /var/log/logguard-matrix-bot
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
