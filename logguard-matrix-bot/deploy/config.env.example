# logguard-matrix-bot's settings: /opt/logguard-matrix-bot/config.env, read by logguard-matrix-bot.service
# (EnvironmentFile). root:logguard-matrix-bot 640. `logguard-matrix-bot --help` describes each option.
# install.sh copies this file there on the first install; it doesn't start the bot while the
# settings below hold their placeholders, or before `logguard-matrix-bot login`.
# No password here: `login` asks for it once and keeps only the access token (in state.json).

# --- Matrix -----------------------------------------------------------------------------

# The homeserver's client URL (https). For matrix.org: https://matrix-client.matrix.org; for
# your own server, what https://<server>/.well-known/matrix/client names as m.homeserver.
MATRIX_HOMESERVER=https://matrix.example.org

# The bot's own account (make one for it in any client, or ask your server's admin):
# @name:server. Not your own account.
MATRIX_USER=@REPLACE_WITH_THE_BOTS_ACCOUNT:example.org

# Your Matrix user id: the only one the bot writes to. It makes a direct chat with you and
# invites you; accept the invitation in your client.
ADMIN=@REPLACE_WITH_YOUR_ACCOUNT:example.org

# Your master cross-signing key (your client calls it the "master key" or identity; the bot
# logs the one it sees). Unset, the key first seen is pinned in state.json. Either way, only
# your devices that key verifies get the room keys. After you reset your cross-signing, the
# bot sends OpenPGP files (below) until you put the new key here and restart it.
#ADMIN_MASTER_KEY=

# End-to-end encryption (Olm/Megolm). no: every message and file as an OpenPGP file.
E2EE=yes

# --- When end-to-end encryption isn't possible -------------------------------------------

# Your OpenPGP public key, exported from OpenKeychain (Android) or iPGMail (iPhone): armored
# or binary, a v4 key, RSA or Curve25519. When a message can't be end-to-end encrypted (a
# changed master key, no verified device, E2EE=no), it goes out as a file encrypted to it;
# without it, messages wait (and alerts expire). A key that is expired or revoked stops the
# bot (exit 78). root:logguard-matrix-bot 640; restart the bot after changing it.
OPENPGP_KEY=/opt/logguard-matrix-bot/admin.asc

# --- What reaches Matrix ----------------------------------------------------------------

# yes: XMPP account names become pseudonyms and the servers' addresses node ids in alerts and
# digests, as on Telegram. Off by default: they are end-to-end encrypted.
SANITIZE=no
# With SANITIZE: the XMPP domains (a bare user name in an alert is taken as on the first) and
# each server's own addresses and host names: node=address,address,name; ...
#XMPP_DOMAINS=example.org
#SERVER_NAMES=xmpp=192.0.2.10,example.org; vpn=192.0.2.20; tg=203.0.113.10

# An alert that waited longer than this (bot down, homeserver out of reach, no way to
# encrypt it) is dropped, and one notice says how many were. The other bots have their own copy.
ALERT_MAX_HOURS=24

# A file (the weekly abuse report) that waited longer than this is deleted unsent.
OUTBOX_MAX_DAYS=7

# --- Files on the server ----------------------------------------------------------------

# Its login, device keys, Olm and Megolm sessions, the room and your pinned keys. Keep it:
# without it the bot needs `login` again, as a new device.
BOT_STATE_PATH=/opt/logguard-matrix-bot/state.json
# What logguard writes for the bot: [notify] matrix_outbox in /etc/logguard/logguard.toml and
# ABUSE_REPORT_MATRIX_OUTBOX in /etc/default/logguard-abuse-report must name the same directory.
OUTBOX_DIR=/opt/logguard-matrix-bot/outbox
# With SANITIZE: the key behind the pseudonyms, made on the first start.
PSEUDONYM_KEY=/opt/logguard-matrix-bot/pseudonym.key
# bot.log goes here (14 days, see /etc/logrotate.d/logguard-matrix-bot); install.sh creates it.
LOG_DIR=/var/log/logguard-matrix-bot
