# The bot keeps bot.log open (appending), so it is copied and truncated in place.
# Rotated weekly, one old copy kept: no line is older than 14 days (/privacy says so).
/var/log/logguard-xmpp-bot/bot.log {
    su ejabberd ejabberd
    weekly
    rotate 1
    maxage 14
    missingok
    notifempty
    copytruncate
}
