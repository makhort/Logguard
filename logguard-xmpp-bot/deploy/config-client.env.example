# logguard-xmpp-bot's settings in client mode: /opt/logguard-xmpp-bot/config.env, read by
# logguard-xmpp-bot.service (EnvironmentFile). root:logguard-xmpp-bot 640: it holds the bot's
# password. `logguard-xmpp-bot --help` describes each option. The release bundle's
# `install.sh --client` copies this file there on the first install and doesn't install the
# bot while values below still start with REPLACE.
#
# Client mode is a copy bot like logguard-tg-bot or logguard-matrix-bot: on any host (a VPN
# server, a relay node, a desktop), with an account on any XMPP server, it sends logguard's
# alerts, daily digest and weekly abuse report to you, OMEMO-encrypted, and as files encrypted
# to your OpenPGP key when OMEMO can't reach you. No ejabberd needed here, no commands.

BOT_MODE=client

# --- The bot's account ----------------------------------------------------------------------

# An account of its own, on any XMPP server (not your own account). It needs HTTP File
# Upload (XEP-0363) for files and fallback files; most public servers have it. A real name,
# not a logguard canary (test, info, support, user, guest, demo, xmpp, jabber, ...: [canary]
# xmpp): on a server guarded by logguard, one failed login on a canary bans the address.
BOT_JID=REPLACE_WITH_THE_BOTS_JID
BOT_PASSWORD=REPLACE_WITH_THE_BOTS_PASSWORD
# Or keep the password in its own file (root:logguard-xmpp-bot 640) and drop BOT_PASSWORD
# above; setting both is an error.
#BOT_PASSWORD_FILE=/opt/logguard-xmpp-bot/password
# Name in the bot's vCard.
BOT_NAME=logguard

# Your bare JID, on any server: the only one the bot writes to and answers (/status, /omemo,
# /help). Add the bot as a contact and accept its subscription request.
ADMIN_JID=REPLACE_WITH_YOUR_JID

# --- The server -----------------------------------------------------------------------------

# Unset: the JID's domain, found through its SRV records. Set it (with XMPP_PORT) for a
# server without them; the certificate is still checked against the JID's domain.
#XMPP_SERVER=
#XMPP_PORT=5222
# auto (direct TLS on port 5223, else STARTTLS), direct or starttls.
#XMPP_TLS=auto
# The bot logs in with SCRAM-SHA-256 only. A server that offers just SCRAM-SHA-1 (Prosody
# before 13) is refused unless this is yes.
#ALLOW_SCRAM_SHA1=no
# The HTTP File Upload service [default: found with disco on the JID's domain].
#UPLOAD_SERVICE=

# --- OMEMO ----------------------------------------------------------------------------------

# on (default) or required: alerts and files go out OMEMO-encrypted to your trusted devices.
# off: every message and file goes out as an OpenPGP file (needs OPENPGP_KEY).
#OMEMO=on
# blind: any device of yours is trusted until you pin keys in omemo-trust.txt (send /omemo to
# the bot for the fingerprints); pinned: only pinned keys are.
#OMEMO_TRUST=blind

# --- When OMEMO can't reach you -------------------------------------------------------------

# Your OpenPGP public key, exported from OpenKeychain (Android) or iPGMail (iPhone): armored or
# binary, a v4 key, RSA or Curve25519. When OMEMO can't reach you (OMEMO=off, your client has
# no OMEMO device, none is trusted), a message or file goes out as a file encrypted to it,
# uploaded to the bot's server and sent as a link; without it, messages wait (and alerts
# expire). A key that is unusable at the start stops the bot (exit 78).
# root:logguard-xmpp-bot 640; restart the bot after changing it.
OPENPGP_KEY=/opt/logguard-xmpp-bot/admin.asc

# An alert that waited longer than this (bot offline, no way to encrypt it) is dropped, and
# one notice says how many were.
#ALERT_MAX_HOURS=24
# A file (the weekly abuse report) that waited longer than this is deleted unsent.
#OUTBOX_MAX_DAYS=7

# --- Files ----------------------------------------------------------------------------------

# Its directory holds the OMEMO keys (omemo.json), the pins (omemo-trust.txt) and the outbox
# (logguard's [notify] xmpp_outbox). Client mode keeps no state.json itself.
BOT_STATE_PATH=/opt/logguard-xmpp-bot/state.json
LOG_DIR=/var/log/logguard-xmpp-bot
# PNG, JPEG, GIF, WebP, BMP or TIFF.
#AVATAR_PATH=/opt/logguard-xmpp-bot/avatar.png
