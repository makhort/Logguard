[Unit]
Description=Telegram bot for logguard's admin messages
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own user: no ejabberd group, no access to ejabberd's files. install.sh creates it
# and sets the owners and modes of /opt/logguard-tg-bot.
User=logguard-tg-bot
Group=logguard-tg-bot
WorkingDirectory=/opt/logguard-tg-bot
EnvironmentFile=/opt/logguard-tg-bot/config.env
ExecStart=/opt/logguard-tg-bot/logguard-tg-bot

Restart=always
RestartSec=5
# 78: Telegram refused the token, or a bad setting. Restarting would not help.
RestartPreventExitStatus=78

# Hardening: the bot reads its outbox and talks HTTPS to Telegram, nothing else.
CapabilityBoundingSet=
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ReadWritePaths=/opt/logguard-tg-bot /var/log/logguard-tg-bot
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
