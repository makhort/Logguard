# logguard-tg-bot's settings: /opt/logguard-tg-bot/config.env, read by logguard-tg-bot.service (EnvironmentFile).
# root:logguard-tg-bot 640, since it holds the token. `logguard-tg-bot --help` describes each option.
# install.sh copies this file there on the first install; it doesn't start the bot while
# TELEGRAM_TOKEN or ADMIN_CHAT_ID still hold the placeholders below.

# --- Telegram ---------------------------------------------------------------------------

# The bot's token from @BotFather (/newbot): <digits>:<about 35 letters, digits, _ and ->.
# Treat it like a password: whoever has it can read and send as the bot.
TELEGRAM_TOKEN=REPLACE_WITH_THE_TOKEN_FROM_BOTFATHER
# Or keep the token in its own file (root:logguard-tg-bot 640) and drop TELEGRAM_TOKEN above; setting
# both is an error.
#TELEGRAM_TOKEN_FILE=/opt/logguard-tg-bot/token

# Your Telegram user id: the only chat the bot serves (0 = not set yet). To find it, with
# the service stopped and the token filled in above, as root:
#   set -a; . /opt/logguard-tg-bot/config.env; set +a; /opt/logguard-tg-bot/logguard-tg-bot pair
ADMIN_CHAT_ID=0

# The Bot API server: Telegram's, or a local Bot API server (http only on localhost).
TELEGRAM_API_URL=https://api.telegram.org

# --- What reaches Telegram --------------------------------------------------------------

# The XMPP domains, separated by commas. Every address-like name@domain in an alert becomes
# a pseudonym anyway; a bare user name (ejabberd:alice) is taken as on the first domain.
XMPP_DOMAINS=example.org

# Each server's own addresses and host names, replaced in alerts and digests by its node id
# (logguard's [cluster] node_id): node=address,address,name; ... Subdomains are included
# (nextcloud.example.org:443 becomes nextcloud.xmpp:443). List every public IPv4 and IPv6
# address of each server; 203.0.113.10 stands for the relay node's address. Node ids need a
# letter other than a-f; loopback and 0.0.0.0 / :: are refused.
SERVER_NAMES=xmpp=11.25.39.236,example.org; vpn=11.33.48.86; tg=203.0.113.10

# Your OpenPGP public key, exported from OpenKeychain (Android) or iPGMail (iPhone): armored
# or binary, a v4 key, RSA or Curve25519. Files (the weekly abuse report) go out encrypted to
# it as a whole, or not at all: without this setting they wait and expire unsent. A key that
# is missing, expired or revoked stops the bot (exit 78). root:logguard-tg-bot 640; restart the bot
# after changing it.
OPENPGP_KEY=/opt/logguard-tg-bot/admin.asc

# Delete the chat's messages, both sides, this many hours after they were sent: 1 to 47
# (Telegram lets bots delete for 48 hours). 0 keeps them until you delete them yourself.
DELETE_AFTER_HOURS=0

# yes: Telegram clients don't allow forwarding, saving or copying alerts (copying an
# address out of one included). Files are never protected.
PROTECT_CONTENT=no

# An alert that waited longer than this (bot down, Telegram out of reach) is dropped,
# and one message says how many were. The XMPP bot has its own copy.
ALERT_MAX_HOURS=24

# A file (the weekly abuse report) that waited longer than this (no key, Telegram out of
# reach) is deleted unsent.
OUTBOX_MAX_DAYS=7

# --- Files on the server ----------------------------------------------------------------

# Its place in Telegram's update queue (and message ids to delete).
BOT_STATE_PATH=/opt/logguard-tg-bot/state.json
# What logguard writes for the bot: [notify] tg_outbox in /etc/logguard/logguard.toml and
# ABUSE_REPORT_TG_OUTBOX in /etc/default/logguard-abuse-report must name the same directory.
OUTBOX_DIR=/opt/logguard-tg-bot/outbox
# The key behind the pseudonyms, made on the first start. Keep it: a new key gives every
# account a new pseudonym.
PSEUDONYM_KEY=/opt/logguard-tg-bot/pseudonym.key
# bot.log goes here (14 days, see /etc/logrotate.d/logguard-tg-bot); install.sh creates it.
LOG_DIR=/var/log/logguard-tg-bot
