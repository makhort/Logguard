# logguard-signal-bot's settings: /opt/logguard-signal-bot/config.env, read by logguard-signal-bot.service
# (EnvironmentFile). root:logguard-signal-bot 640. `logguard-signal-bot --help` describes each option.
# install.sh copies this file there on the first install; it doesn't start the bot while the
# settings below hold their placeholders, or before the bot's account is registered or linked.

# --- signal-cli -------------------------------------------------------------------------

# signal-cli (https://github.com/AsamK/signal-cli, GPL-3.0, installed separately): its native
# build (x86_64 Linux), or the Java build's bin/signal-cli (Java 21 or later; for ARM).
SIGNAL_CLI=/usr/local/bin/signal-cli
# Its data directory: the bot account's keys and sessions (logguard-signal-bot 700).
SIGNAL_CLI_DATA=/opt/logguard-signal-bot/signal-cli
# More arguments for `signal-cli jsonRpc` (the bot reads nothing people send it).
SIGNAL_CLI_ARGS="--ignore-attachments --ignore-stories"

# --- Signal -----------------------------------------------------------------------------

# The bot's own Signal account: a phone number registered with signal-cli, or a Signal
# account signal-cli is linked to as a device. Not your own account.
SIGNAL_ACCOUNT=+REPLACE_WITH_THE_BOTS_NUMBER

# Your Signal phone number (or your account's ACI): the only one the bot writes to.
ADMIN=+REPLACE_WITH_YOUR_NUMBER

# The safety number with the bot, as your Signal app shows it (the bot's chat → its name →
# View safety number; 60 digits, blanks ignored). Unset, the one first seen is pinned in
# state.json, and the bot logs it. When it changes (you reinstalled Signal, or someone took
# over your number), the bot sends only OpenPGP files (below) until you put the new one here
# and restart it.
#ADMIN_SAFETY_NUMBER=

# --- While the safety number isn't the pinned one ----------------------------------------

# Your OpenPGP public key, exported from OpenKeychain (Android) or iPGMail (iPhone): armored
# or binary, a v4 key, RSA or Curve25519. Messages and files go out as files encrypted to it;
# without it they wait (and alerts expire). A key that is expired or revoked stops the bot
# (exit 78). root:logguard-signal-bot 640; restart the bot after changing it.
OPENPGP_KEY=/opt/logguard-signal-bot/admin.asc

# --- What reaches Signal ----------------------------------------------------------------

# yes: XMPP account names become pseudonyms and the servers' addresses node ids in alerts and
# digests, as on Telegram. Off by default: they are end-to-end encrypted.
SANITIZE=no
# With SANITIZE: the XMPP domains and each server's own addresses and host names.
#XMPP_DOMAINS=example.org
#SERVER_NAMES=xmpp=192.0.2.10,example.org; vpn=192.0.2.20; tg=203.0.113.10

# An alert that waited longer than this is dropped, and one message says how many were.
ALERT_MAX_HOURS=24
# A file (the weekly abuse report) that waited longer than this is deleted unsent.
OUTBOX_MAX_DAYS=7

# --- Files on the server ----------------------------------------------------------------

# The pinned safety number.
BOT_STATE_PATH=/opt/logguard-signal-bot/state.json
# What logguard writes for the bot: [notify] signal_outbox in /etc/logguard/logguard.toml and
# ABUSE_REPORT_SIGNAL_OUTBOX in /etc/default/logguard-abuse-report must name the same directory.
OUTBOX_DIR=/opt/logguard-signal-bot/outbox
# With SANITIZE: the key behind the pseudonyms, made on the first start.
PSEUDONYM_KEY=/opt/logguard-signal-bot/pseudonym.key
# bot.log goes here (14 days, see /etc/logrotate.d/logguard-signal-bot); install.sh creates it.
LOG_DIR=/var/log/logguard-signal-bot
