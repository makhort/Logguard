[Unit]
Description=Signal bot for logguard's admin messages (through signal-cli)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own user: no ejabberd group, no access to ejabberd's files. install.sh creates it
# and sets the owners and modes of /opt/logguard-signal-bot (signal-cli's data included).
User=logguard-signal-bot
Group=logguard-signal-bot
WorkingDirectory=/opt/logguard-signal-bot
EnvironmentFile=/opt/logguard-signal-bot/config.env
# The bot starts signal-cli (SIGNAL_CLI) as its child and stops it with itself.
ExecStart=/opt/logguard-signal-bot/logguard-signal-bot

Restart=always
RestartSec=5
# 78: a bad setting, or signal-cli didn't start (an account not registered or linked yet).
# Restarting would not help.
RestartPreventExitStatus=78

# Hardening: the bot reads its outbox, signal-cli talks HTTPS and WebSockets to Signal.
# No MemoryDenyWriteExecute: the Java build of signal-cli compiles code at run time (JIT).
CapabilityBoundingSet=
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ReadWritePaths=/opt/logguard-signal-bot /var/log/logguard-signal-bot
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
